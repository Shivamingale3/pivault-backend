# App
APP_PORT=5000
APP_ENV=development

# PostgreSQL — dev/prod database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# PostgreSQL — test database (dropped & recreated on every `npm test` run)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_test

# Redis — cache (sessions, reset tokens) and BullMQ job queues.
# Use rediss:// with a password in production, or keep Redis bound to localhost on the Pi.
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=pivault

# Redis for tests. Leave unset and `npm test` starts a throwaway Docker Redis.
# TEST_REDIS_URL=redis://localhost:6379/15
