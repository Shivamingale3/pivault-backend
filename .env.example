# App
APP_PORT=5000
APP_ENV=development
# Public URL of the PWA; password-setup links in emails point here (required in production).
APP_URL=https://vault.example.com

# PostgreSQL — dev/prod database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app # ggignore

# PostgreSQL — test database (dropped & recreated on every `npm test` run)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_test # ggignore

# Email (SMTP) — welcome + password-reset mails. Port 465 = implicit TLS, otherwise STARTTLS.
# Leave all EMAIL_* unset in dev/test to only log emails (required in production).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=YOUR_EMAIL_USER
EMAIL_PASSWORD=YOUR_EMAIL_PASSWORD
EMAIL_FROM=PiVault <no-reply@example.com>
