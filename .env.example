# App
APP_PORT=5000
APP_ENV=development
# Public URL of the PWA; password-setup links in emails point here (required in production).
APP_URL=https://vault.example.com

# PostgreSQL — dev/prod database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# PostgreSQL — test database (dropped & recreated on every `npm test` run)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_test

# Redis — cache (sessions, reset tokens) and BullMQ job queues.
# Use rediss:// with a password in production, or keep Redis bound to localhost on the Pi.
REDIS_CACHE_URL=redis://:pw@100.83.1.25:6379
REDIS_QUEUE_URL=redis://:pw@100.83.1.25:6380
REDIS_KEY_PREFIX=pivault

# Redis for tests. Leave unset and `npm test` starts a throwaway Docker Redis.
# TEST_REDIS_URL=redis://localhost:6379/15

# Email (SMTP) — welcome + password-reset mails. Port 465 = implicit TLS, otherwise STARTTLS.
# Leave all EMAIL_* unset in dev/test to only log emails (required in production).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=YOUR_EMAIL_USER
EMAIL_PASSWORD=YOUR_EMAIL_PASSWORD
EMAIL_FROM=PiVault <no-reply@example.com>
