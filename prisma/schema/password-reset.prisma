/// Single-use link token that lets a user set their password (first-time onboarding or forgot
/// password). One live token per user; a newer one replaces the older.
model PasswordResetToken {
  id        String   @id @default(ulid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 (hex) of the random token. The raw token only ever exists in the emailed link.
  tokenHash String   @unique @db.Char(64)
  /// "onboarding" | "reset"
  purpose   String   @db.VarChar(16)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("password_reset_tokens")
}
