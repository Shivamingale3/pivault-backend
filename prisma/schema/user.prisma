/// A vault owner. Created only through the local register API (no public sign-up).
model User {
  id                      String    @id @default(ulid())
  firstName               String    @db.VarChar(50)
  lastName                String    @db.VarChar(50)
  /// Stored lower-cased; unique across users.
  email                   String    @unique @db.VarChar(254)
  /// Calling-code digits without "+", e.g. "91". Always paired with `mobile`.
  countryCode             String    @db.VarChar(3)
  /// National significant number, digits only, e.g. "9876543210"; unique per country code.
  mobile                  String    @db.VarChar(14)
  /// argon2id hash of the account password (never the vault key).
  passwordHash            String
  passwordChangedAt       DateTime?
  /// Set once the client has generated its recovery key. The key itself never reaches the server.
  recoveryKeyConfiguredAt DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  session Session?

  @@unique([countryCode, mobile])

  @@map("users")
}
