// Multi-file Prisma schema — https://pris.ly/d/multi-file-schema
//
// Every *.prisma file in this folder (recursively) is merged into one schema.
// This file holds only the generator + datasource; each domain model lives in
// its own file (e.g. user.prisma). Models can reference each other across
// files without imports. Migrations live in ../migrations (see prisma.config.ts).

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}
